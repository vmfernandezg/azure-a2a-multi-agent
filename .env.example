# ===========================================
# Configuracion de API Keys - Orquestador Azure A2A
# ===========================================

# OpenAI API Key (requerida para LLM)
OPENAI_API_KEY=sk-your-openai-api-key-here

# ===========================================
# Azure Service Principal (REQUERIDO)
# ===========================================
# Crear Service Principal: az ad sp create-for-rbac --name "a2a-orchestrator" --role Reader

AZURE_CLIENT_ID=your-client-id
AZURE_CLIENT_SECRET=your-client-secret
AZURE_TENANT_ID=your-tenant-id
AZURE_SUBSCRIPTION_ID=your-default-subscription-id

# Subscripciones adicionales (opcional)
AZURE_SUBSCRIPTION_1=subscription-id-1
AZURE_SUBSCRIPTION_2=subscription-id-2

# ===========================================
# Configuracion Opcional
# ===========================================

# Serper API Key (para herramientas de busqueda web)
# SERPER_API_KEY=your-serper-api-key

# Directorio personalizado para almacenamiento de CrewAI
# CREWAI_STORAGE_DIR=./crewai_storage

# ===========================================
# Proveedores de Embeddings Alternativos
# ===========================================

# Google AI (para usar embeddings de Google)
# GOOGLE_API_KEY=your-google-api-key

# ===========================================
# Configuracion de Desarrollo
# ===========================================

# Nivel de logging (DEBUG, INFO, WARNING, ERROR)
# LOG_LEVEL=INFO
